  m_Script: {fileID: 11500000, guid: da7462228bf9a5f49a7be9f22b6fd018, type: 3}
  m_Name: 2015 alcohol
  m_EditorClassIdentifier: 
  title: Alcohol Restrictions 2015
  info: 'Under the Liquor Control (Supply and Consumption) Act, drinking alcohol
    in public places is prohibited from 10:30 PM to 7:00 AM to curb public disturbances
    and maintain order. Exceptions are made for licensed establishments like bars
    and restaurants, which can serve alcohol during these hours. Designated Liquor
    Control Zones, such as Geylang and Little India, have even stricter rules. Violators
    face fines of up to SGD 1,000 for first offenses and higher penalties for repeat
    violations.  '
  image: {fileID: 21300000, guid: f67ded3ac7bbb49c487b247f821248f0, type: 3}
